background {
	monitor = 
	path = ~/Pictures/wallpapers/wallhaven-5ymlv9.png
	blur_passes = 2
}

input-field {
	monitor = 
	size = 250, 50
	outline_thickness = 2
	pllaceholder_text = <span foreground="##cdd6f4"> Pass </span>
	position = 0, -20
	halign = center
	valign = center
}

label {
	monitor=
	text = cmd[update:1000] echo "$(date +%H:%M:%S)"
	position = 0,100
	halign = center
	valign = center
}


